import flixel.FlxG;
import funkin.graphics.adobeanimate.FlxAtlasSprite;
import funkin.modding.module.Module;
import funkin.modding.module.ModuleHandler;
import funkin.play.character.CharacterDataParser;
import funkin.play.components.HealthIcon;
import funkin.ui.freeplay.FreeplayState;
import flixel.math.FlxPoint;
import openfl.geom.Matrix;
import openfl.display.BitmapData;

class FS_FreeplayIcon extends FlxAtlasSprite
{
  /**
   * The original matrix data for the icon.
   */
  final originalMatrixData:Dynamic;

  /**
   * The current character ID for the icon.
   */
  var currentCharacterID:String = "";

  public function new(x:Float, y:Float)
  {
    super(x, y, Paths.animateAtlas("freeplay/fs_freeplay-icon"),
      {
        FrameRate: 24.0,
        Reversed: false,
        // ?OnComplete:Void -> Void,
        ShowPivot: false,
        Antialiasing: true,
        ScrollFactor: new FlxPoint(1, 1),
      });

    zIndex = 900;

    onAnimationFrame.add((animationName:String, frameNumber:Int) -> {
      if (animationName == "fs icon char switch" && frameNumber == 9)
      {
        updateHealthIcon();
      }
    });

    onAnimationComplete.add((animationName:String) -> {
      if (animationName == "fs icon char switch")
      {
        playAnimation("fs icon idle", true, false, true);
      }
    });
  }

  function updateHealthIcon():Void
  {
    var characterData:Dynamic = CharacterDataParser.fetchCharacterData(FS_SaveData.instance.bf);

    var healthIcon:HealthIcon = new HealthIcon('dad', 0);
    healthIcon.configure(characterData?.healthIcon);
    healthIcon.playAnimation("idle");
    healthIcon.animation.pause();
    healthIcon.updateFramePixels();
    currentCharacterID = healthIcon.characterId;

    var iconGraphic:FlxGraphic = FlxG.bitmap.add(healthIcon.framePixels);
    replaceFrameGraphic(7, iconGraphic);

    var element:FlxElement = this.anim.symbolDictionary.get("ICON_GOES_HERE").getElement(0);
    var scaleFactor:Float = 1.65;

    if (originalMatrixData == null)
    {
      originalMatrixData =
        {
          a: element.matrix.a,
          b: element.matrix.b,
          c: element.matrix.c,
          d: element.matrix.d,
          tx: element.matrix.tx,
          ty: element.matrix.ty
        };
    }
    else
    {
      element.matrix.a = originalMatrixData.a;
      element.matrix.b = originalMatrixData.b;
      element.matrix.c = originalMatrixData.c;
      element.matrix.d = originalMatrixData.d;
      element.matrix.tx = originalMatrixData.tx;
      element.matrix.ty = originalMatrixData.ty;
    }

    element.matrix.a *= scaleFactor + 0.2;
    element.matrix.d *= scaleFactor;

    element.matrix.tx -= 60;
    element.matrix.ty -= 40;
  }
}
